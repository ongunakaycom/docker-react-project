tenancy_ocid     = "ocid1.tenancy.oc1..aaaa..."
user_ocid        = "ocid1.user.oc1..aaaa..."
fingerprint      = "xx:xx:xx:..."
private_key_path = "C:/Users/robin/.oci/oci_api_key.pem"
region           = "eu-frankfurt-1"
compartment_ocid = "ocid1.tenancy.oc1..aaaa..."   # root compartment = tenancy OCID

service_name = "reactops"

# Get this from OCI Console → Compute → Instances → your VM → Availability Domain
# Or run: oci iam availability-domain list --compartment-id <tenancy_ocid>
availability_domain = "FVLm:EU-FRANKFURT-1-AD-3"

# Paste your SSH public key here (see note below)
ssh_public_key = "ssh-rsa AAAA... your-email@example.com"